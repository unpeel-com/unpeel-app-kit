{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpeel.com/protocol/unpeel-ui-v1.schema.json",
  "title": "Unpeel App Kit UI protocol v1",
  "description": "Durable component projections between terminal Apps and Host-brokered native, web, or agent participants. Attachments use Host-minted route-bound participant tokens. Implementations ignore unknown fields inside recognized message and value kinds. An unsupported component kind causes pane-level terminal fallback without rejecting the attachment.",
  "oneOf": [
    { "$ref": "#/$defs/attach" },
    { "$ref": "#/$defs/attached" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/delta" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/lifecycle" },
    { "$ref": "#/$defs/requestSnapshot" },
    { "$ref": "#/$defs/presence" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "protocolName": { "const": "unpeel.ui" },
    "protocolVersion": { "const": 1 },
    "offeredProtocolVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "grant": {
      "anyOf": [
        { "const": "*" },
        { "$ref": "#/$defs/identifier" }
      ]
    },
    "appMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["human", "agent", "service"],
          "default": "human"
        },
        "sourceSessionId": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1 },
        "color": { "type": "string" },
        "grants": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/grant" }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/identifier" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "rendererState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rendererVisible", "terminalVisible"],
      "properties": {
        "rendererVisible": { "type": "boolean" },
        "terminalVisible": { "type": "boolean" }
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "protocol",
        "minProtocolVersion",
        "maxProtocolVersion",
        "participantToken",
        "clientId",
        "renderer",
        "viewId"
      ],
      "properties": {
        "type": { "const": "attach" },
        "protocol": { "$ref": "#/$defs/protocolName" },
        "minProtocolVersion": { "$ref": "#/$defs/offeredProtocolVersion" },
        "maxProtocolVersion": { "$ref": "#/$defs/offeredProtocolVersion" },
        "participantToken": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "clientId": { "$ref": "#/$defs/identifier" },
        "renderer": { "$ref": "#/$defs/renderer" },
        "viewId": { "$ref": "#/$defs/identifier" },
        "expectedAppInstanceId": { "$ref": "#/$defs/identifier" },
        "lastSeenRevision": { "$ref": "#/$defs/revision" },
        "state": { "$ref": "#/$defs/rendererState" }
      }
    },
    "attached": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "protocol",
        "protocolVersion",
        "minProtocolVersion",
        "maxProtocolVersion",
        "app",
        "appInstanceId",
        "participantId",
        "clientId",
        "rendererId",
        "viewId",
        "resumed"
      ],
      "properties": {
        "type": { "const": "attached" },
        "protocol": { "$ref": "#/$defs/protocolName" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "minProtocolVersion": { "$ref": "#/$defs/offeredProtocolVersion" },
        "maxProtocolVersion": { "$ref": "#/$defs/offeredProtocolVersion" },
        "app": { "$ref": "#/$defs/appMetadata" },
        "appInstanceId": { "$ref": "#/$defs/identifier" },
        "participantId": { "$ref": "#/$defs/identifier" },
        "clientId": { "$ref": "#/$defs/identifier" },
        "rendererId": { "$ref": "#/$defs/identifier" },
        "viewId": { "$ref": "#/$defs/identifier" },
        "resumed": { "type": "boolean" },
        "currentRevision": { "$ref": "#/$defs/revision" }
      }
    },
    "textPosition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["line", "utf16Column"],
      "properties": {
        "line": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "utf16Column": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "textRange": {
      "type": "object",
      "additionalProperties": true,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/textPosition" },
        "end": { "$ref": "#/$defs/textPosition" }
      }
    },
    "textSelection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["anchor", "head"],
      "properties": {
        "anchor": { "$ref": "#/$defs/textPosition" },
        "head": { "$ref": "#/$defs/textPosition" }
      }
    },
    "textEdit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["range", "text"],
      "properties": {
        "range": { "$ref": "#/$defs/textRange" },
        "text": { "type": "string" }
      }
    },
    "markdownActions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replaceRange": { "$ref": "#/$defs/identifier" },
        "setSelection": { "$ref": "#/$defs/identifier" },
        "save": { "$ref": "#/$defs/identifier" },
        "undo": { "$ref": "#/$defs/identifier" },
        "redo": { "$ref": "#/$defs/identifier" },
        "setPresentation": { "$ref": "#/$defs/identifier" }
      }
    },
    "markdownEditor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "text", "selection"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "markdownEditor" },
        "text": { "type": "string" },
        "selection": { "$ref": "#/$defs/textSelection" },
        "presentation": {
          "enum": ["source", "preview", "split"],
          "default": "source"
        },
        "readOnly": { "type": "boolean", "default": false },
        "dirty": { "type": "boolean", "default": false },
        "placeholder": { "type": "string", "default": "" },
        "title": { "type": "string" },
        "actions": { "$ref": "#/$defs/markdownActions" }
      }
    },
    "mediaSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "path" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "mediaType", "base64"],
          "properties": {
            "kind": { "const": "inline" },
            "mediaType": {
              "type": "string",
              "minLength": 7,
              "maxLength": 127,
              "pattern": "^image/[A-Za-z0-9!#$&^_.+/-]+$"
            },
            "base64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 349528,
              "contentEncoding": "base64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "sha256", "mediaType", "byteLength"],
          "properties": {
            "kind": { "const": "blob" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "mediaType": {
              "type": "string",
              "minLength": 7,
              "maxLength": 127,
              "pattern": "^image/[A-Za-z0-9!#$&^_.+/-]+$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "mediaPixelSize": {
      "type": "object",
      "additionalProperties": true,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "h": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "mediaCellSize": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["w"] },
        { "required": ["h"] }
      ],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "h": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "mediaPointSize": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["w"] },
        { "required": ["h"] }
      ],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "h": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "source", "intrinsic", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "media" },
        "source": { "$ref": "#/$defs/mediaSource" },
        "intrinsic": { "$ref": "#/$defs/mediaPixelSize" },
        "cells": { "$ref": "#/$defs/mediaCellSize" },
        "points": { "$ref": "#/$defs/mediaPointSize" },
        "fit": { "enum": ["contain", "cover", "fill"], "default": "contain" },
        "alt": { "type": "string", "maxLength": 16384 },
        "activate": { "$ref": "#/$defs/identifier" }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id", "label", "value", "setValue"],
      "properties": {
        "type": { "const": "toggle" },
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 4096 },
        "value": { "type": "boolean" },
        "setValue": { "$ref": "#/$defs/identifier" }
      }
    },
    "unsupportedRowSlot": {
      "description": "Opaque future row control retained so a renderer can fall back to the terminal pane.",
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": { "type": { "$ref": "#/$defs/identifier" } },
      "not": {
        "required": ["type"],
        "properties": { "type": { "const": "toggle" } }
      }
    },
    "listItemSlot": {
      "oneOf": [
        { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/unsupportedRowSlot" }
      ]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 16384 },
        "done": { "type": "boolean", "default": false },
        "leading": { "$ref": "#/$defs/listItemSlot" },
        "trailing": { "$ref": "#/$defs/listItemSlot" },
        "accessory": { "$ref": "#/$defs/listItemSlot" },
        "delete": { "$ref": "#/$defs/identifier" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id", "items"],
      "properties": {
        "type": { "const": "list" },
        "id": { "$ref": "#/$defs/identifier" },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/listItem" }
        },
        "emptyMessage": { "type": "string", "maxLength": 4096 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "input" },
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 4096 },
        "value": { "type": "string", "maxLength": 1048576 },
        "placeholder": { "type": "string", "maxLength": 4096 },
        "setValue": { "$ref": "#/$defs/identifier" },
        "submit": { "$ref": "#/$defs/identifier" }
      }
    },
    "unsupportedHeaderSlot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": { "type": { "$ref": "#/$defs/identifier" } },
      "not": {
        "required": ["type"],
        "properties": { "type": { "const": "input" } }
      }
    },
    "unsupportedBodySlot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": { "type": { "$ref": "#/$defs/identifier" } },
      "not": {
        "required": ["type"],
        "properties": { "type": { "const": "list" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "page" },
        "title": { "type": "string", "maxLength": 4096 },
        "header": {
          "oneOf": [
            { "$ref": "#/$defs/input" },
            { "$ref": "#/$defs/unsupportedHeaderSlot" }
          ]
        },
        "body": {
          "oneOf": [
            { "$ref": "#/$defs/list" },
            { "$ref": "#/$defs/unsupportedBodySlot" }
          ]
        }
      }
    },
    "unsupportedComponent": {
      "description": "Opaque future root retained only so a renderer can keep its attachment and expose the terminal pane.",
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" }
      },
      "not": {
        "required": ["type"],
        "properties": {
          "type": { "enum": ["markdownEditor", "media", "page"] }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "protocol",
        "protocolVersion",
        "appInstanceId",
        "clientId",
        "viewId",
        "revision",
        "root"
      ],
      "properties": {
        "type": { "const": "snapshot" },
        "protocol": { "$ref": "#/$defs/protocolName" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "appInstanceId": { "$ref": "#/$defs/identifier" },
        "clientId": { "$ref": "#/$defs/identifier" },
        "viewId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" },
        "root": {
          "oneOf": [
            { "$ref": "#/$defs/markdownEditor" },
            { "$ref": "#/$defs/media" },
            { "$ref": "#/$defs/page" },
            { "$ref": "#/$defs/unsupportedComponent" }
          ]
        }
      }
    },
    "deltaOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "root"],
          "properties": {
            "op": { "const": "replaceRoot" },
            "root": {
              "oneOf": [
                { "$ref": "#/$defs/markdownEditor" },
                { "$ref": "#/$defs/media" },
                { "$ref": "#/$defs/page" },
                { "$ref": "#/$defs/unsupportedComponent" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "edit"],
          "properties": {
            "op": { "const": "markdownReplaceRange" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "edit": { "$ref": "#/$defs/textEdit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "selection"],
          "properties": {
            "op": { "const": "markdownSetSelection" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "selection": { "$ref": "#/$defs/textSelection" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "presentation"],
          "properties": {
            "op": { "const": "markdownSetPresentation" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "presentation": { "enum": ["source", "preview", "split"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "dirty"],
          "properties": {
            "op": { "const": "markdownSetDirty" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "dirty": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "readOnly"],
          "properties": {
            "op": { "const": "markdownSetReadOnly" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "readOnly": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "title"],
          "properties": {
            "op": { "const": "markdownSetTitle" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "title": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "placeholder"],
          "properties": {
            "op": { "const": "markdownSetPlaceholder" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "placeholder": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "actions"],
          "properties": {
            "op": { "const": "markdownSetActions" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "actions": { "$ref": "#/$defs/markdownActions" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "source", "intrinsic"],
          "properties": {
            "op": { "const": "mediaSetSource" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "source": { "$ref": "#/$defs/mediaSource" },
            "intrinsic": { "$ref": "#/$defs/mediaPixelSize" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "value"],
          "properties": {
            "op": { "const": "toggleSetValue" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "nodeId", "value"],
          "properties": {
            "op": { "const": "inputSetValue" },
            "nodeId": { "$ref": "#/$defs/identifier" },
            "value": { "type": "string", "maxLength": 1048576 }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "listId", "index", "item"],
          "properties": {
            "op": { "const": "listInsertItem" },
            "listId": { "$ref": "#/$defs/identifier" },
            "index": { "$ref": "#/$defs/revision" },
            "item": { "$ref": "#/$defs/listItem" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "listId", "itemId"],
          "properties": {
            "op": { "const": "listRemoveItem" },
            "listId": { "$ref": "#/$defs/identifier" },
            "itemId": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "delta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "protocol",
        "protocolVersion",
        "appInstanceId",
        "clientId",
        "viewId",
        "baseRevision",
        "revision",
        "operations"
      ],
      "properties": {
        "type": { "const": "delta" },
        "protocol": { "$ref": "#/$defs/protocolName" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "appInstanceId": { "$ref": "#/$defs/identifier" },
        "clientId": { "$ref": "#/$defs/identifier" },
        "viewId": { "$ref": "#/$defs/identifier" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "revision": { "$ref": "#/$defs/revision" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/deltaOperation" }
        }
      }
    },
    "eventValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "index" },
            "value": { "$ref": "#/$defs/revision" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "integer" },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "number" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "text" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "textList" },
            "value": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "textEdit" },
            "value": { "$ref": "#/$defs/textEdit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "textSelection" },
            "value": { "$ref": "#/$defs/textSelection" }
          }
        }
      ]
    },
    "event": {
